@page "/booking"
@model ClinicEngine.Web.Pages.Booking.BookingModel
@{
    ViewData["Title"] = "Book Appointment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="booking-page">

    <div class="booking-header">
        <h1 class="booking-title">Book an Appointment</h1>
        <a href="/admin/dashboard" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Back to Dashboard
        </a>
    </div>

    @if (Model.SuccessMessage is not null)
    {
        <div class="alert alert--success" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <div class="booking-grid">

        <section class="booking-form-section">
            <div class="form-card">
                <h2 class="form-card__title">Appointment Details</h2>

             
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="All" class="validation-summary"></div>
                }

                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Input.DepartmentId" class="form-label">
                            Department <span class="required">*</span>
                        </label>
                        <select asp-for="Input.DepartmentId"
                                asp-items="Model.Departments"
                                class="form-control"
                                id="departmentSelect">
                            <option value="0">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="Input.DepartmentId" class="field-validation-error"></span>
                    </div>

               
                    <div class="form-group">
                        <label asp-for="Input.DoctorId" class="form-label">
                            Doctor <span class="required">*</span>
                        </label>
                        <select asp-for="Input.DoctorId"
                                asp-items="Model.Doctors"
                                class="form-control"
                                id="doctorSelect">
                            <option value="0">-- Select Doctor --</option>
                        </select>
                        <span asp-validation-for="Input.DoctorId" class="field-validation-error"></span>
                    </div>

                 
                    <div class="form-group">
                        <label asp-for="Input.PatientId" class="form-label">
                            Patient <span class="required">*</span>
                        </label>
                        <select asp-for="Input.PatientId"
                                asp-items="Model.Patients"
                                class="form-control">
                            <option value="0">-- Select Patient --</option>
                        </select>
                        <span asp-validation-for="Input.PatientId" class="field-validation-error"></span>
                    </div>


                    <div class="form-group">
                        <label asp-for="Input.AppointmentDate" class="form-label">
                            Appointment Date <span class="required">*</span>
                        </label>
                        <input asp-for="Input.AppointmentDate"
                               type="date"
                               class="form-control"
                               id="appointmentDate"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                     
                        <span asp-validation-for="Input.AppointmentDate" class="field-validation-error"></span>
                    </div>


                    <div class="form-group" id="slotGroup" style="display:none;">
                        <label asp-for="Input.AppointmentTime" class="form-label">
                            Available Time Slots <span class="required">*</span>
                        </label>
                        <div id="slotsContainer" class="slots-grid"></div>
                        <input asp-for="Input.AppointmentTime"
                               type="hidden"
                               id="appointmentTimeInput" />
                        <span asp-validation-for="Input.AppointmentTime" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Input.Notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Any additional notes (optional)..."></textarea>
                        <span asp-validation-for="Input.Notes" class="field-validation-error"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn--primary" id="submitBtn" disabled>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Book Appointment
                        </button>
                        <a href="/admin/dashboard" class="btn btn--secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </section>

      

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        let selectedDoctorId = 0;

        // ── Department → Doctor cascade ───────────────────────────────────
        document.getElementById('departmentSelect').addEventListener('change', async function () {
        const departmentId = this.value;
        const doctorSelect = document.getElementById('doctorSelect');

        doctorSelect.innerHTML = '<option value="0">Loading...</option>';
        doctorSelect.disabled = true;
        resetSlots();

        if (!departmentId || departmentId === '0') {
        doctorSelect.innerHTML = '<option value="0">-- Select Doctor --</option>';
        doctorSelect.disabled = false;
        return;
        }

        try {
        const response = await fetch(`/booking?handler=DoctorsByDepartment&departmentId=${departmentId}`);
        if (!response.ok) throw new Error('Failed');
        const doctors = await response.json();
        doctorSelect.innerHTML = '<option value="0">-- Select Doctor --</option>';
        doctors.forEach(d => {
        const option = document.createElement('option');
        option.value = d.id;
        option.textContent = `${d.name} — ${d.specialization}`;
        doctorSelect.appendChild(option);
        });
        } catch {
        doctorSelect.innerHTML = '<option value="0">-- Could not load doctors --</option>';
        } finally {
        doctorSelect.disabled = false;
        }
        });

        // ── Doctor or Date change → load available slots ──────────────────
        document.getElementById('doctorSelect').addEventListener('change', loadSlots);
        document.getElementById('appointmentDate').addEventListener('change', loadSlots);

        async function loadSlots() {
        const doctorId = document.getElementById('doctorSelect').value;
        const date = document.getElementById('appointmentDate').value;
        selectedDoctorId = doctorId;

        if (!doctorId || doctorId === '0' || !date) {
        resetSlots();
        return;
        }

        const container = document.getElementById('slotsContainer');
        const slotGroup = document.getElementById('slotGroup');
        container.innerHTML = '<p style="color:#64748b;font-size:0.875rem;">Loading available slots...</p>';
        slotGroup.style.display = 'block';

        try {
        const response = await fetch(`/api/appointments/available-slots?doctorId=${doctorId}&date=${date}`);
        if (!response.ok) throw new Error('Failed');
        const data = await response.json();
        const slots = data.value ?? data;

        if (!slots || slots.length === 0) {
        container.innerHTML = '<p style="color:#dc2626;font-size:0.875rem;">No availability found for this doctor on this date.</p>';
        document.getElementById('submitBtn').disabled = true;
        return;
        }

        container.innerHTML = '';
        slots.forEach(slot => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = slot.isAvailable ? 'slot-btn slot-btn--available' : 'slot-btn slot-btn--taken';
        btn.textContent = slot.slotTime.substring(0, 5);
        btn.disabled = !slot.isAvailable;
        btn.title = slot.isAvailable ? 'Click to select this slot' : 'Already booked';

        if (slot.isAvailable) {
        btn.addEventListener('click', function () {
        document.querySelectorAll('.slot-btn--selected').forEach(b => b.classList.remove('slot-btn--selected'));
        btn.classList.add('slot-btn--selected');
        document.getElementById('appointmentTimeInput').value = slot.slotTime;
        document.getElementById('submitBtn').disabled = false;
        });
        }
        container.appendChild(btn);
        });

        } catch {
        container.innerHTML = '<p style="color:#dc2626;font-size:0.875rem;">Could not load slots. Please try again.</p>';
        }
        }

        function resetSlots() {
        document.getElementById('slotGroup').style.display = 'none';
        document.getElementById('slotsContainer').innerHTML = '';
        document.getElementById('appointmentTimeInput').value = '';
        document.getElementById('submitBtn').disabled = true;
        }
    </script>

    <style>
        .slots-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.25rem;
        }

        .slot-btn {
        padding: 0.4rem 0.875rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.15s;
        font-family: inherit;
        }

        .slot-btn--available {
        background: #f0fdf4;
        color: #166534;
        border-color: #86efac;
        }

        .slot-btn--available:hover {
        background: #dcfce7;
        border-color: #4ade80;
        }

        .slot-btn--selected {
        background: #166534 !important;
        color: white !important;
        border-color: #166534 !important;
        }

        .slot-btn--taken {
        background: #fef2f2;
        color: #991b1b;
        border-color: #fecaca;
        cursor: not-allowed;
        opacity: 0.6;
        }
    </style>
}
